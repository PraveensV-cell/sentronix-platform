# ==========================================================
# SENTRONIX AI PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and customize for your deployment host
# ==========================================================

# Hosting Environment Mode (development | staging | production)
ENVIRONMENT=production

# Server Host & Ports
HOST=0.0.0.0
PORT=8000
FRONTEND_PORT=80
DEV_FRONTEND_PORT=5173

# Database Configuration
# Default: Embedded SQLite in ml-platform/database/sentronix.db
# For PostgreSQL: postgresql://postgres:sentronix_secure_pass@localhost:5432/sentronix_db
DATABASE_URL=sqlite:///./ml-platform/database/sentronix.db
POSTGRES_DB=sentronix_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sentronix_secure_pass
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis Cache & Bus
REDIS_URL=redis://localhost:6379/0

# RabbitMQ Message Broker
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Security & Authentication
JWT_SECRET_KEY=sentronix_production_super_secret_jwt_key_2026_xyz
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Development Mock OTP Mode (true: returns 6-digit OTP in API response for evaluation/testing)
DEV_MOCK_OTP_ENABLED=true

# AI Perception & Vision Pipeline
AI_DEVICE=cpu
DEFAULT_YOLO_MODEL=yolo11s.pt
CONFIDENCE_THRESHOLD=0.45
IOU_THRESHOLD=0.50
INFERENCE_FPS=25

# Storage & Evidence Retention
STORAGE_PROVIDER=local
STORAGE_PATH=./ml-platform/evidence
EVIDENCE_RETENTION_DAYS=30

# CORS Allowed Origins
CORS_ORIGINS=*
