# Copy this file to .env for local development. Replace all CHANGE_ME values.
# Never commit the resulting .env file or reuse local values in production.

POSTGRES_DB=sentronix
POSTGRES_USER=sentronix
POSTGRES_PASSWORD=CHANGE_ME

APP_NAME=Sentronix API Gateway
APP_VERSION=1.0.0
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
DEBUG=false
API_PREFIX=/api/v1
API_DESCRIPTION=Sentronix API Gateway
CONTACT_NAME=Sentronix
CONTACT_EMAIL=admin@example.com
LICENSE_NAME=MIT

JWT_SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=sentronix
DATABASE_USER=sentronix
DATABASE_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+psycopg2://sentronix:CHANGE_ME@postgres:5432/sentronix

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=sentronix@example.com
ADMIN_EMAIL=admin@example.com

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME

SENTRONIX_MODELS_DIR=./models
# After placing models/yolo11s.pt, uncomment the next line to use it:
# YOLO_MODEL=/models/yolo11s.pt
