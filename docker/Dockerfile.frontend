# ==========================================================
# SENTRONIX AI PLATFORM - PRODUCTION FRONTEND DOCKERFILE
# ==========================================================

# Stage 1: Build React/TypeScript Dashboard with Vite
FROM node:20-alpine AS builder

WORKDIR /app

# Copy dependency manifests
COPY ml-platform/dashboard/package*.json ./

# Install npm dependencies
RUN npm ci --silent

# Copy all source files
COPY ml-platform/dashboard/ ./

# Build production assets
RUN npm run build

# Stage 2: Serve with Nginx
FROM nginx:1.27-alpine

# Remove default nginx html
RUN rm -rf /usr/share/nginx/html/*

# Copy built assets from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy production reverse-proxy configuration
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=20s --timeout=5s --retries=3 \
    CMD wget -q --spider http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
